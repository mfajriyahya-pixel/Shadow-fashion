                <div class="flex justify-end space-x-2 pt-2 border-t">
                    <button type="button" onclick="closeModal('adminModal')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-lg transition">Batal</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg transition shadow">Simpan Stok Baru</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-5 right-5 bg-gray-900 text-white px-4 py-3 rounded-xl shadow-2xl z-50 hidden flex items-center space-x-3 text-xs border border-gray-700">
        <i class="fas fa-info-circle text-blue-400 text-base"></i>
        <span id="toastMessage">Pesan Notifikasi</span>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // Database Produk Bawaan Awal (Default Initial Data)
        const initialProducts = [
            {
                id: 1,
                name: "Jaket Bomber Exclusive Shadow",
                category: "Pria",
                brand: "SHADOW Official",
                price: 185000,
                oldPrice: 250000,
                sizes: ["M", "L", "XL", "XXL"],
                stock: 15,
                isPromo: true,
                image: "https://images.unsplash.com/photo-1551028719-00167b16eac5?w=500&auto=format&fit=crop&q=80",
                spec: "Bahan Waterproof Parasut Premium, Furing Quilting Tebal, Zipper YKK Anti Macet, Saku Dalam Praktis."
            },
            {
                id: 2,
                name: "Gaun Casual Floral Summer",
                category: "Wanita",
                brand: "Shadow Woman",
                price: 135000,
                oldPrice: 190000,
                sizes: ["S", "M", "L"],
                stock: 8,
                isPromo: true,
                image: "https://images.unsplash.com/photo-1572804013309-59a88b7e92f1?w=500&auto=format&fit=crop&q=80",
                spec: "Bahan Rayon Viscose High Grade, Lembut & Adem, Fitur Karet Pinggang Elastis, Motif Printing Awet."
            },
            {
                id: 3,
                name: "Setelan Baju Anak Superhero Kids",
                category: "Anak",
                brand: "Shadow Kids",
                price: 75000,
                oldPrice: 110000,
                sizes: ["S (2-3 thn)", "M (4-5 thn)", "L (6-7 thn)"],
                stock: 25,
                isPromo: true,
                image: "https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=500&auto=format&fit=crop&q=80",
                spec: "Bahan Cotton Combed 24s 100% Organik, Aman Untuk Kulit Sensitif Anak, Menyerap Keringat Cepat."
            },
            {
                id: 4,
                name: "Kemeja Polos Basic Formal Dewasa",
                category: "Dewasa",
                brand: "SHADOW Executive",
                price: 120000,
                oldPrice: 0,
                sizes: ["M", "L", "XL"],
                stock: 30,
                isPromo: false,
                image: "https://images.unsplash.com/photo-1596755094514-f87e34085b2c?w=500&auto=format&fit=crop&q=80",
                spec: "Bahan Katun Poplin Premium, Jahitan Presisi Standar Ekspor, Kerah Kaku & Rapi, Cocok Kerja/Formal."
            },
            {
                id: 5,
                name: "Hoodie Polos Streetwear Oversize",
                category: "Pria",
                brand: "SHADOW Co",
                price: 160000,
                oldPrice: 0,
                sizes: ["L", "XL"],
                stock: 12,
                isPromo: false,
                image: "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=500&auto=format&fit=crop&q=80",
                spec: "Bahan Cotton Fleece 300 Gsm Tebal & Halus, Tali Topi Bulat Tipis Premium, Saku Kanguru Depan."
            },
            {
                id: 6,
                name: "Blouse Modern Elegance",
                category: "Wanita",
                brand: "Shadow Woman",
                price: 115000,
                oldPrice: 150000,
                sizes: ["M", "L"],
                stock: 18,
                isPromo: true,
                image: "https://images.unsplash.com/photo-1584273143981-41c073dfe8f8?w=500&auto=format&fit=crop&q=80",
                spec: "Bahan Satin Silk Premium, Berkilau Elegan, Tidak Menerawang, Lengan Wudhu Friendly."
            }
        ];

        // State Management LocalStorage
        let products = JSON.parse(localStorage.getItem('shadow_products')) || initialProducts;
        let selectedCategory = 'all';
        let selectedProductForOrder = null;

        // Toggle visibility promo price on admin form
        document.getElementById('isPromo').addEventListener('change', function(e) {
            const container = document.getElementById('promoPriceContainer');
            if (e.target.checked) {
                container.classList.remove('hidden');
            } else {
                container.classList.add('hidden');
            }
        });

        // Initialize App
        window.onload = function() {
            renderProducts();
        };

        // Render Product Cards
        function renderProducts() {
            const promoGrid = document.getElementById('promoGrid');
            const productGrid = document.getElementById('productGrid');
            const emptyState = document.getElementById('emptyState');
            const searchQuery = (document.getElementById('searchInput').value || document.getElementById('searchInputMobile').value || '').toLowerCase();

            promoGrid.innerHTML = '';
            productGrid.innerHTML = '';

            // Filter logic
            const filteredProducts = products.filter(p => {
                const matchCategory = (selectedCategory === 'all') || (p.category === selectedCategory);
                const matchSearch = p.name.toLowerCase().includes(searchQuery) ||
                                    p.brand.toLowerCase().includes(searchQuery) ||
                                    p.spec.toLowerCase().includes(searchQuery);
                return matchCategory && matchSearch;
            });

            // Promos (Filtered)
            const promoProducts = filteredProducts.filter(p => p.isPromo);

            // Hide/Show Promo section if empty
            const promoSection = document.getElementById('promoSection');
            if (promoProducts.length === 0) {
                promoSection.classList.add('hidden');
            } else {
                promoSection.classList.remove('hidden');
                promoProducts.forEach(product => {
                    promoGrid.appendChild(createProductCard(product, true));
                });
            }

            // Normal Catalogue
            if (filteredProducts.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
                filteredProducts.forEach(product => {
                    productGrid.appendChild(createProductCard(product, false));
                });
            }
        }

        // Card HTML Template Creator
        function createProductCard(product, isPromoCard) {
            const card = document.createElement('div');
            card.className = "bg-white rounded-xl shadow-sm hover:shadow-lg border border-gray-100 overflow-hidden flex flex-col justify-between transition-all duration-300 group";

            const formattedPrice = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(product.price);
            const formattedOldPrice = product.oldPrice ? new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(product.oldPrice) : '';

            card.innerHTML = `
                <div>
                    <div class="relative aspect-square overflow-hidden bg-gray-100">
                        <img src="${product.image}" alt="${product.name}" onerror="this.src='https://placehold.co/400x400/1e293b/ffffff?text=Baju+Shadow'" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        ${product.isPromo ? `<span class="absolute top-2 left-2 bg-red-600 text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full shadow-md">HOT PROMO</span>` : ''}
                        <span class="absolute bottom-2 right-2 bg-gray-900/80 backdrop-blur-sm text-white text-[10px] px-2 py-0.5 rounded font-medium">${product.category}</span>
                    </div>

                    <div class="p-3.5 space-y-2">
                        <div>
                            <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider block">${product.brand}</span>
                            <h3 class="font-bold text-gray-900 text-xs sm:text-sm line-clamp-1 group-hover:text-blue-600 transition" title="${product.name}">${product.name}</h3>
                        </div>

                        <div class="flex items-baseline space-x-1.5">
                            <span class="text-sm sm:text-base font-extrabold text-blue-600">${formattedPrice}</span>
                            ${product.oldPrice ? `<span class="text-[10px] sm:text-xs text-gray-400 line-through">${formattedOldPrice}</span>` : ''}
                        </div>

                        <div class="text-[11px] text-gray-500 space-y-1">
                            <div class="flex justify-between">
                                <span>Ukuran:</span>
                                <span class="font-semibold text-gray-700">${product.sizes.join(', ')}</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Sisa Stok:</span>
                                <span class="font-semibold ${product.stock < 5 ? 'text-red-500 font-bold' : 'text-gray-700'}">${product.stock} pcs</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-3.5 pt-0">
                    <button onclick="openDetailModal(${product.id})" class="w-full bg-gray-900 hover:bg-blue-600 text-white text-xs font-semibold py-2 px-3 rounded-lg transition duration-200 flex items-center justify-center gap-1.5 shadow">
                        <i class="fas fa-shopping-bag"></i> Detail & Order
                    </button>
                </div>
            `;
            return card;
        }

        // Category Filter Function
        function setCategory(cat) {
            selectedCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.className = "cat-btn bg-gray-200 text-gray-700 hover:bg-gray-300 px-4 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition";
            });
            const activeBtn = document.getElementById(`cat-${cat}`);
            if (activeBtn) {
                activeBtn.className = "cat-btn bg-gray-900 text-white px-4 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition shadow-sm";
            }
            renderProducts();
        }

        // Sync Search bar input
        function syncAndSearch(val) {
            document.getElementById('searchInput').value = val;
            renderProducts();
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('searchInputMobile').value = '';
            setCategory('all');
        }

        // Open Detail & Order Modal
        function openDetailModal(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;

            selectedProductForOrder = product;

            document.getElementById('modalTitle').innerText = product.name;
            document.getElementById('modalName').innerText = product.name;
            document.getElementById('modalBrand').innerText = `Merk/Brand: ${product.brand}`;
            document.getElementById('modalCategory').innerText = `Kategori ${product.category}`;
            document.getElementById('modalImage').src = product.image;
            document.getElementById('modalSpec').innerText = product.spec;
            document.getElementById('modalStock').innerText = `${product.stock} Pcs`;
            
            // Prices
            document.getElementById('modalPrice').innerText = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(product.price);
            
            const oldPriceEl = document.getElementById('modalOldPrice');
            if (product.oldPrice) {
                oldPriceEl.innerText = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(product.oldPrice);
                oldPriceEl.classList.remove('hidden');
            } else {
                oldPriceEl.classList.add('hidden');
            }

            // Promo Badge
            const badgeEl = document.getElementById('modalBadge');
            if (product.isPromo) {
                badgeEl.classList.remove('hidden');
            } else {
                badgeEl.classList.add('hidden');
            }

            // Sizes Display & Select Options
            const sizesContainer = document.getElementById('modalSizes');
            const sizeSelect = document.getElementById('orderSize');
            sizesContainer.innerHTML = '';
            sizeSelect.innerHTML = '';

            product.sizes.forEach(size => {
                sizesContainer.innerHTML += `<span class="bg-gray-100 text-gray-800 text-[11px] font-bold px-2.5 py-1 rounded border border-gray-200">${size}</span>`;
                sizeSelect.innerHTML += `<option value="${size}">${size}</option>`;
            });

            openModal('productModal');
        }

        // Submit Order to WA or IG
        function submitOrder(platform) {
            if (!selectedProductForOrder) return;

            const name = document.getElementById('orderName').value.trim();
            const size = document.getElementById('orderSize').value;
            const qty = document.getElementById('orderQty').value;
            const payment = document.getElementById('orderPayment').value;
            const address = document.getElementById('orderAddress').value.trim();

            if (!name || !address) {
                showToast("Mohon lengkapi Nama dan Alamat Pemesan!");
                return;
            }

            const totalPrice = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(selectedProductForOrder.price * qty);

            // Format Pesanan
            const textMessage = `Halo Toko SHADOW, Saya mau order via Website:%0A%0A` +
                `*Detail Pesanan:*%0A` +
                `- Produk: ${selectedProductForOrder.name}%0A` +
                `- Merk: ${selectedProductForOrder.brand}%0A` +
                `- Ukuran: ${size}%0A` +
                `- Jumlah: ${qty} pcs%0A` +
                `- Total Harga: ${totalPrice}%0A%0A` +
                `*Data Pembeli:*%0A` +
                `- Nama: ${name}%0A` +
                `- Metode Pembayaran: ${payment}%0A` +
                `- Alamat Lengkap: ${address}%0A%0A` +
                `Mohon segera diproses ya, terima kasih!`;

            if (platform === 'wa') {
                const waUrl = `https://wa.me/6285861437850?text=${textMessage}`;
                window.open(waUrl, '_blank');
            } else if (platform === 'ig') {
                // WhatsApp fallback/alert for IG direct since IG DM web link deep query isn't standardized
                const igUrl = `https://instagram.com/m.fazrii14`;
                navigator.clipboard ? navigator.clipboard.writeText(decodeURIComponent(textMessage)) : null;
                alert("Format rincian pesanan telah disalin ke clipboard! Silahkan paste / tempel di DM Instagram @m.fazrii14");
                window.open(igUrl, '_blank');
            }

            closeModal('productModal');
            showToast("Mengarahkan ke layanan pemesanan...");
        }

        // Handle Form Input Stok Baru (Admin)
        function handleAddNewStock(e) {
            e.preventDefault();

            const title = document.getElementById('newTitle').value.trim();
            const category = document.getElementById('newCategory').value;
            const brand = document.getElementById('newBrand').value.trim();
            const price = parseFloat(document.getElementById('newPrice').value);
            const stock = parseInt(document.getElementById('newStock').value);
            const rawSizes = document.getElementById('newSizes').value.trim();
            const isPromo = document.getElementById('isPromo').checked;
            const oldPrice = isPromo ? parseFloat(document.getElementById('newOldPrice').value || 0) : 0;
            const imageInput = document.getElementById('newImage').value.trim();
            const spec = document.getElementById('newSpec').value.trim();

            const sizesArr = rawSizes ? rawSizes.split(',').map(s => s.trim()) : ["All Size"];
            const defaultImg = "https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?w=500&auto=format&fit=crop&q=80";

            const newProduct = {
                id: Date.now(),
                name: title,
                category: category,
                brand: brand,
                price: price,
                oldPrice: oldPrice,
                sizes: sizesArr,
                stock: stock,
                isPromo: isPromo,
                image: imageInput || defaultImg,
                spec: spec
            };

            // Simpan ke array & localStorage
            products.unshift(newProduct);
            localStorage.setItem('shadow_products', JSON.stringify(products));

            // Reset form & UI
            document.getElementById('addStockForm').reset();
            document.getElementById('promoPriceContainer').classList.add('hidden');
            closeModal('adminModal');
            renderProducts();

            showToast("Stok pakaian baru berhasil ditambahkan ke katalog!");
        }

        // Helper UI Modal Controls
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // Helper Toast Notification
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }
    </script>
